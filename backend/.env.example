# Backend Environment Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Hindsight Persistent Memory Configuration
# - Cloud: base_url is https://api.hindsight.vectorize.io (requires HINDSIGHT_API_KEY)
# - Self-hosted: base_url is http://localhost:8888 (API key optional depending on setup)
HINDSIGHT_API_KEY=your_hindsight_api_key_here
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
HINDSIGHT_BANK_ID=feedback-synthesizer

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000
